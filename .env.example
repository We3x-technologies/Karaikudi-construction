# ========================================================
# Karaikudi Construction - Enquiry Contact Form Environment
# ========================================================

# The recipient email address for enquiry submissions.
# Defaults to karaikudiconstruction@gmail.com if not specified.
VITE_ENQUIRY_EMAIL=karaikudiconstruction@gmail.com

# Optional: Custom backend API endpoint or serverless function URL.
# If left blank or unset, submissions use the secure FormSubmit AJAX endpoint.
# Example: https://api.karaikudiconstruction.com/enquiry
# VITE_ENQUIRY_API_URL=
